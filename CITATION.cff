    given-names: Koorosh
    affiliation: "Tarbiat Modares University"
license: GPL-3.0-only
keywords:
  - OTFS
  - ISAC
  - MDDIPIC
  - parameter estimation
repository-code: "https://github.com/krsham/mddipic_paper"
